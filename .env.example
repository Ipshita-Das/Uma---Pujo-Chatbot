# ---- AI (Groq) ----
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
# Groq models (check https://console.groq.com/docs/models if one stops working).
# Tried in order; the next one takes over when one is busy.
GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Must accept images, for outfit photos:
GROQ_VISION_MODELS=qwen/qwen3.8-27b

# ---- AI backup (Gemini) ----
# Used when Groq is busy. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tried in order after Groq; these also handle photos. See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# ---- Server ----
PORT=3001
# Set to 1 when serving over HTTPS so the login cookie is HTTPS-only
# COOKIE_SECURE=1
# Set to 1 behind a hosting proxy (Railway, Render, nginx) so rate limits see each visitor's real address
# TRUST_PROXY=1
# Optional: where to keep the local database file (default server/data/pujo.db)
# DB_PATH=server/data/pujo.db

# ---- Database ----
# Leave these empty to use a local file (server/data/pujo.db) on your computer.
# On Render, set them to your Turso database (see "Deploying" in the README).
# TURSO_DATABASE_URL=libsql://uma-yourname.turso.io
# TURSO_AUTH_TOKEN=

# ---- Sign in with Google ----
# OAuth client ID from Google Cloud (see the README, "Setting up Google sign-in").
# It is public (it appears in the page), so it is not a secret.
GOOGLE_CLIENT_ID=

# ---- Backups ----
# With a local database the server backs it up once a day; `npm run backup` works with Turso too.
# BACKUP_DIR=server/backups
# BACKUP_KEEP=14
